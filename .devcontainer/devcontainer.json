// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
	"name": "open-tombola",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"build": {
		"dockerfile": "./Dockerfile"
	},
	"containerEnv": {
		"KUBECONFIG": "/home/open-tombola/.kube/config:/home/open-tombola/scripts/k8s/kubeconfig-cz2nls.yml"
	},
	"features": {
		"ghcr.io/devcontainers/features/common-utils": {
			"installZsh": true,
			"installOhMyZsh": true,
			"configureZshAsDefaultShell": "true",
			"upgradePackages": "true"
		},
		"ghcr.io/devcontainers/features/git:1": {},
		"ghcr.io/devcontainers-extra/features/nx-npm": {},
		"ghcr.io/devcontainers-extra/features/angular-cli:2": {},
		"ghcr.io/devcontainers/features/docker-outside-of-docker": {},
		"ghcr.io/devcontainers/features/terraform": {
			"version": "1.9.0"
		},
		"ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"nrwl.angular-console",
				"ms-playwright.playwright"
			]
		}
	},
	"mounts": [
		"source=${localEnv:HOME}/.ssh,target=/home/open-tombola/.ssh,type=bind,consistency=cached",
		"source=${localEnv:HOME}/.kube,target=/home/open-tombola/.kube,type=bind,consistency=cached",
		"source=${localEnv:HOME}/scripts,target=/home/open-tombola/scripts,type=bind,consistency=cached"
	],
	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],
	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "yarn install",
	// Configure tool-specific properties.
	// "customizations": {},
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	"remoteUser": "open-tombola"
}
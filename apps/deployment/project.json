{
  "name": "deployment",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/deployment/src",
  "targets": {
    "helm-upgrade-local": {
      "command": "helm upgrade open-tombola apps/deployment/src/open-tombola -f apps/deployment/src/open-tombola/dev-values.yaml"
    },
    "helm-install-envoy-gateway": {
      "command": "helm install eg oci://docker.io/envoyproxy/gateway-helm --version v1.7.1 -n envoy-gateway-system --create-namespace"
    },
    "helm-add-repo-jetstack": {
      "command": "helm repo add jetstack https://charts.jetstack.io"
    },
    "helm-install-cert-manager-local": {
      "command": "helm install cert-manager jetstack/cert-manager --version v1.17.0 --namespace open-tombola-dev --create-namespace --set config.apiVersion=\"controller.config.cert-manager.io/v1alpha1\" --set config.kind=\"ControllerConfiguration\" --set config.enableGatewayAPI=true",
      "dependsOn": [
        "helm-add-repo-jetstack"
      ]
    },
    "helm-uninstall-cert-manager-local": {
      "command": "helm uninstall cert-manager"
    },
    "helm-install-open-tombola-local": {
      "command": "helm install open-tombola apps/deployment/src/open-tombola -f apps/deployment/src/open-tombola/dev-values.yaml"
    },
    "helm-install-cert-manager-production": {
      "command": "helm install cert-manager jetstack/cert-manager --version v1.17.0 --namespace cert-manager --create-namespace --set config.apiVersion=\"controller.config.cert-manager.io/v1alpha1\" --set config.kind=\"ControllerConfiguration\" --set config.enableGatewayAPI=true",
      "dependsOn": [
        "helm-add-repo-jetstack"
      ]
    },
    "helm-install-open-tombola-production": {
      "command": "helm install open-tombola apps/deployment/src/open-tombola -f apps/deployment/src/open-tombola/prod-values.yaml"
    },
    "helm-upgrade-open-tombola-production": {
      "command": "helm upgrade open-tombola apps/deployment/src/open-tombola -f apps/deployment/src/open-tombola/prod-values.yaml"
    },
    "helm-uninstall-open-tombola": {
      "command": "helm uninstall open-tombola"
    },
    "k8s-api-deployment-apply": {
      "command": "kubectl apply -f apps/deployment/src/api-deployment.yml -n open-tombola"
    },
    "k8s-api-deployment-delete": {
      "command": "kubectl delete deployments open-tombola-api-deployment -n open-tombola"
    },
    "k8s-api-secret-create": {
      "command": "kubectl create secret generic env-api --from-env-file apps/deployment/src/.env.api -n open-tombola"
    },
    "k8s-api-service-apply": {
      "command": "kubectl apply -f apps/deployment/src/api-service.yml -n open-tombola"
    },
    "k8s-api-service-delete": {
      "command": "kubectl delete -f apps/deployment/src/api-service.yml -n open-tombola"
    },
    "k8s-database-deployment-apply": {
      "command": "kubectl apply -f apps/deployment/src/database-deployment.yml -n open-tombola"
    },
    "k8s-database-deployment-delete": {
      "command": "kubectl delete deployments open-tombola-database-deployment -n open-tombola"
    },
    "k8s-database-service-apply": {
      "command": "kubectl apply -f apps/deployment/src/database-service.yml -n open-tombola"
    },
    "k8s-database-secret-create": {
      "command": "kubectl create secret generic env-database --from-env-file apps/deployment/src/.env.database -n open-tombola"
    },
    "k8s-get-services": {
      "command": "kubectl get services -n open-tombola"
    },
    "k8s-frontend-deployment-delete": {
      "command": "kubectl delete deployments open-tombola-frontend-deployment -n open-tombola"
    },
    "k8s-frontend-deployment-apply": {
      "command": "kubectl apply -f apps/deployment/src/frontend-deployment.yml -n open-tombola"
    },
    "k8s-frontend-service-apply": {
      "command": "kubectl apply -f apps/deployment/src/frontend-load-balancer.yml -n open-tombola"
    },
    "k8s-namespace-create": {
      "command": "kubectl create ns open-tombola"
    },
    "k8s-namespace-delete": {
      "command": "kubectl delete ns open-tombola"
    }
  },
  "tags": []
}
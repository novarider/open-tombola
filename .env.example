# Environment Variables for Tombola Application
# Copy this to a .env file and fill in with actual values

# ============================================
# API Server Environment Variables
# ============================================

# Node.js Runtime
NODE_ENV=production
DEBUG=tombola:*

# Server Configuration
HOST=0.0.0.0
PORT=3333

# Database
DATABASE_URL=postgresql://tombola:password@localhost:5432/tombola
DATABASE_SSL=true

# Stripe Payment Processing
STRIPE_API_KEY=sk_live_your_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CURRENCY=EUR

# Application
APP_NAME=Tombola
APP_VERSION=1.0.0
APP_TIMEZONE=Europe/Vienna

# CORS Configuration
CORS_ORIGIN=https://your-domain.com
CORS_CREDENTIALS=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=file

# Authentication
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=7d
REFRESH_TOKEN_EXPIRATION=30d

# Email Configuration
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@your-domain.com

# S3/Object Storage
S3_ENDPOINT=https://s3.ion.ionos.com
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET=tombola-backup
S3_REGION=eu-central-1

# Feature Flags
ENABLE_OFFLINE_REGISTRATION=true
ENABLE_ONLINE_REGISTRATION=true
ENABLE_ADMIN_PANEL=true

# Event Configuration (from requirements)
EVENT_DATE=2024-10-24
REGISTRATION_DEADLINE=2024-10-17T12:00:00Z
MINIMUM_ENTRIES=1
MAXIMUM_ENTRIES=10
TICKET_PRICE=25

# ============================================
# Frontend Environment Variables
# ============================================

# API Configuration
REACT_APP_API_URL=https://api.your-domain.com
REACT_APP_API_TIMEOUT=30000

# Stripe Public Key
REACT_APP_STRIPE_PUBLIC_KEY=pk_live_your_stripe_public_key

# Application Configuration
REACT_APP_NAME=Tombola
REACT_APP_VERSION=1.0.0

# Feature Toggles
REACT_APP_ENABLE_OFFLINE=true
REACT_APP_ENABLE_ONLINE=true
REACT_APP_ENABLE_ADMIN=true

# Google Analytics (optional)
REACT_APP_GA_ID=your-google-analytics-id

# ============================================
# Deployment Configuration
# ============================================

# Terraform Variables (use terraform.tfvars instead)
# These are here for reference only

# Ionos Cloud
IONOS_USERNAME=your-ionos-email
IONOS_PASSWORD=your-ionos-password
IONOS_ENDPOINT=https://api.ionos.com

# Infrastructure
DATACENTER_LOCATION=de
API_CORES=2
API_RAM=2048
FRONTEND_CORES=2
FRONTEND_RAM=2048

# ============================================
# Development Environment (docker-compose)
# ============================================

# Database
POSTGRES_USER=tombola
POSTGRES_PASSWORD=tombola-dev-password
POSTGRES_DB=tombola

# Redis (if enabled)
REDIS_URL=redis://redis:6379

# ============================================
# Security & Secrets
# ============================================

# These should be stored securely in your CI/CD:
# - Use GitHub Secrets
# - Use Ionos Cloud secrets manager
# - Use environment-specific encrypted files
# - Never commit actual credentials to Git

# SSL Certificates
SSL_CERT_PATH=/etc/letsencrypt/live/your-domain.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/your-domain.com/privkey.pem

# ============================================
# Monitoring & Observability
# ============================================

# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-key@sentry.io/your-project-id
SENTRY_ENVIRONMENT=production

# NewRelic (optional)
NEW_RELIC_APP_NAME=Tombola
NEW_RELIC_LICENSE_KEY=your-newrelic-license-key

# Datadog (optional)
DD_TRACE_ENABLED=true
DD_SERVICE=tombola-api
DD_ENV=production

# ============================================
# Development Overrides
# ============================================

# Uncomment and modify for development

# NODE_ENV=development
# DEBUG=tombola:*
# LOG_LEVEL=debug
# DATABASE_URL=postgresql://tombola:password@localhost:5432/tombola_dev
# CORS_ORIGIN=http://localhost:4200

# ============================================
# Notes
# ============================================

# 1. Never commit actual values to Git
# 2. Use .env.local for machine-specific overrides
# 3. Use .env.production for production-specific values
# 4. Rotate secrets periodically
# 5. Use strong, unique passwords
# 6. Keep sensitive files with restricted permissions
# 7. Update these values when deploying to new environments
# 8. Document any additional required variables
